<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

    <!-- ── App Sandbox (required for Mac App Store; good practice always) ── -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- ── File system access ── -->

    <!-- Read files the user explicitly selects (open panel, drag & drop) -->
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>

    <!-- Read ~/Desktop — needed so ScreenshotWatcher can list new screenshot files -->
    <!-- Note: you must also have NSDesktopFolderUsageDescription in Info.plist -->
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>

    <!-- ── Network (not required by ClipBoard, but harmless if you add sharing later) ── -->
    <!-- <key>com.apple.security.network.client</key> -->
    <!-- <true/> -->

</dict>
</plist>
